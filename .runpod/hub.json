{
  "title": "Koboldcpp [Test]",
  "description": "Versitile AI server - Language Models - Images - TTS - Music",
  "endpointType": "LB",
  "category": "language",
  "iconUrl": "https://koboldai.com/img/koboldai-logo.png",
  "config": {
    "runsOn": "GPU",
    "containerDiskInGb": 200,
    "presets": [
      {
        "name": "Tiefighter Combo",
        "defaults": {
          "KCPP_MODEL": "https://huggingface.co/KoboldAI/LLaMA2-13B-Tiefighter-GGUF/resolve/main/LLaMA2-13B-Tiefighter.Q4_K_S.gguf"
        }
      }
    ],
    "env": [
      {
        "key": "PORT",
        "value": "5001"
      },
      {
        "key": "PORT_HEALTH",
        "value": "5001"
      },
      {
        "key": "KCPP_MODEL",
        "input": {
          "name": "Language Model",
          "type": "string",
          "description": "GGUF Language Model (You only need 00001-of for multiple)",
          "default": "https://huggingface.co/KoboldAI/LLaMA2-13B-Tiefighter-GGUF/resolve/main/LLaMA2-13B-Tiefighter.Q4_K_S.gguf",
          "advanced": false
        }
      }
    ]
  }
}
